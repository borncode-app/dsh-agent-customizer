{
  "name": "@local/dsh-agent-customizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lets the user tune each agent in the Web GUI: per-agent Instructions in the system prompt, and the deployment default model.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/borncode-app/dsh-agent-customizer.git" },
  "homepage": "https://github.com/borncode-app/dsh-agent-customizer#readme",
  "bugs": { "url": "https://github.com/borncode-app/dsh-agent-customizer/issues" },
  "keywords": ["dsh","deepseek-harness","dsh-plugin","agent","prompts","system-prompt","settings","customization"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-general"]
    }
  }
}
